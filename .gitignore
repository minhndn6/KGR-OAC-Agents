# ─────────────────────────────────────────────────────────────
# SECRETS — TUYỆT ĐỐI KHÔNG commit
# ─────────────────────────────────────────────────────────────
.secrets/
**/.secrets/
*.env
*.env.*
tokens.json
**/tokens.json

# Local config workspace-ROOT: settings.local.json (allowlist/creds riêng máy) + worktrees → ignore.
# settings.json + hooks/ ĐƯỢC track (enforcement hygiene INV-4, chia sẻ theo repo). .claude/skills builder KHÔNG đụng.
# (Creds vẫn an toàn: *.env / tokens.json / .secrets/ đã ignore ở trên.)
/.claude/settings.local.json
/.claude/worktrees/
**/.claude/worktrees/

# ─────────────────────────────────────────────────────────────
# Runtime & durable state (giữ NGOÀI repo theo quy ước hygiene)
# ─────────────────────────────────────────────────────────────
_orchestration/
_work/
**/_work/
**/blackboards/

# ─────────────────────────────────────────────────────────────
# Scratch / handoff (sub-.gitignore cũng phủ; nhắc lại cho chắc)
# ─────────────────────────────────────────────────────────────
_PNL_*
_DB01_*
_build_heatmap*
_combochip*
*.network-response
_resp_*
_snap_*

# ─────────────────────────────────────────────────────────────
# Python caches
# ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# OS cruft
Thumbs.db
.DS_Store
desktop.ini
