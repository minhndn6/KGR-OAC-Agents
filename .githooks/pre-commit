#!/bin/sh
# KGR monorepo pre-commit (INV-4) — VERSIONED & SHARED (git config core.hooksPath=.githooks).
# Thay .git/hooks/pre-commit local-only (không clone theo). Chặn commit nếu tree bẨN.
# Bật: python OAC-Knowledge/kb_lifecycle/tools/kgr.py setup  (đặt core.hooksPath=.githooks)
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
py=$(command -v python || command -v python3)
if [ -z "$py" ]; then
  echo "pre-commit: KHÔNG thấy python — bỏ qua gate (cài python để bật)."; exit 0
fi
"$py" OAC-Knowledge/kb_lifecycle/tools/check_clean.py --strict || {
  echo ""
  echo "pre-commit: BẨN — scratch/state bị track HOẶC rác vật lý trong cây (ngoài _work/)."
  echo "  • Track nhầm: git rm --cached <file>  (đã có .gitignore)."
  echo "  • Rác vật lý: chuyển ra kgr_runtime.work_dir()/scratch() NGOÀI project, hoặc 'kgr.py gc --apply'."
  exit 1
}
exit 0
